# ---- copy to backend/.env for local development ----
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true
# Optional: password of every seeded demo account (default demo1234, as in README/docs). If you change it,
# re-run the seed (scripts/seed_firestore.py) so Firebase Auth users get the same password.
# DEMO_PASSWORD=

# Storage: auto | memory | postgres | firestore
#   auto => PostgreSQL when DATABASE_URL is set, else the in-memory demo store (seeded, resets on restart)
STORAGE=auto
# PostgreSQL / AlloyDB / Supabase (after applying database/001..003 SQL):
# DATABASE_URL=postgresql://vlm_app:<password>@<host>:5432/<db>
DATABASE_URL=
# Cloud Firestore / Firebase (STORAGE=firestore and/or AUTH_PROVIDER=firebase). Credentials: ADC
# (`gcloud auth application-default login`) locally, the Cloud Run service account in production.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# Auth: local (our PBKDF2 passwords + JWTs) | firebase (verify Firebase ID tokens from the web app)
AUTH_PROVIDER=local

# Execution: auto => Judge0 when JUDGE0_URL is set, else local subprocess (dev only)
EXECUTION_ENGINE=auto
# RapidAPI Judge0 CE:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=<rapidapi key>
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_PYTHON_LANGUAGE_ID=71
EXECUTION_TIMEOUT_SECONDS=8

# Google AI Studio key (https://aistudio.google.com/apikey). Empty => deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMMA_MODEL=gemma-4-26b-a4b-it
